# ---------------------------------------------------------------- private
# Everything here belongs to whoever is running the app, not to the project.
#
# cache/ is the big one: it holds the Spotify OAuth token, the four Chrome
# profiles (with their cookies and saved logins), downloaded album art, the
# lyrics cache and any images dragged in. None of it should ever be committed.
cache/
config.json

# Belt and braces, in case any of these ever appear.
*.token.json
spotify_token.json
.env
*.pem
*.key

# ---------------------------------------------------------------- artwork
# Pictures dropped in here get bundled into the build, and some of them are
# other people's work. Shipping those from a public repository is not mine to
# do, so the folder stays local. The build treats it as optional and works
# fine without it - see build.bat.
built in themes/

# ---------------------------------------------------------------- build
# Build output belongs on the releases page, not in git history: it is tens of
# megabytes per build and regenerable from source in one command.
dist/
.build-env/
__pycache__/
*.pyc
*.spec
